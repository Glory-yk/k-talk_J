# Makemoney AI Lab — PayPal API 환경 변수
# 🛑 절대 이 파일을 git 에 commit 하지 마세요 (시크릿)
# 발급 방법: https://developer.paypal.com/dashboard/applications

CLIENT_ID=<여기에 Client ID 입력>
CLIENT_SECRET=<여기에 Client Secret 입력>
APP_NAME=Makemoney AI Lab
PAYPAL_ENV=live  # or sandbox for testing

# 가격 정책
K_TALK_AI_7DAY_PRICE=4.99
K_TALK_AI_MONTHLY_PRICE=9.99
WORK_ABROAD_7DAY_PRICE=9.99
WORK_ABROAD_MONTHLY_PRICE=24.99

# 모니터링 설정
REVENUE_CHECK_INTERVAL=3600  # 1시간마다 매출 분석
DATA_RETENTION_DAYS=30